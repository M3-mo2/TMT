# ── Required ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
ADMIN_IDS=  # Comma-separated list of Telegram user IDs that can access /admin (e.g. 123456789,987654321)

# API credentials from https://my.telegram.org (API development tools).
# These identify the application used to connect the *user accounts*.
API_ID=
API_HASH=

# ── Optional (defaults shown) ───────────────────────────────────────────────
# LOG_LEVEL=INFO

# Runtime data directory (SQLite DB, master key). Created automatically.
# DATA_DIR=data

# Master key for encrypting Telegram session strings (Fernet, url-safe base64).
# If empty, a key is generated on first run into DATA_DIR/keys/master.key (0600).
# WARNING: losing this key means all stored sessions must re-login.
# SESSIONS_MASTER_KEY=

# MAX_CONCURRENT_JOBS=3
# MAX_RUNNING_JOBS_PER_USER=1
# MAX_MEMBERS_PER_JOB=2000
# INVITE_DELAY_SECONDS=2.0
# INVITE_DELAY_JITTER_SECONDS=1.0
# FLOOD_WAIT_MAX_SECONDS=900
# PEER_FLOOD_COOLDOWN_SECONDS=3600
# JOB_TIMEOUT_SECONDS=14400
# LOGIN_TTL_SECONDS=600
# PROGRESS_EDIT_MIN_INTERVAL=4.0
